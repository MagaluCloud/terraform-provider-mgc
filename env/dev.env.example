# Perfil dev: fake server local.
# Copie para env/dev.env (gitignorado) e ajuste. Formato KEY=value puro,
# sem aspas nem export: o Makefile inclui e exporta estas linhas.
MGC_ENDPOINT=http://localhost:8080
MGC_API_KEY=00000000-0000-4000-8000-000000000000
MGC_REGION=br-se1

# Polling rapido para ITERACAO LIVE contra o fake (make testacc-live):
# ProviderConfig injeta polling_interval/polling_timeout no bloco do provider.
# NAO grave cassettes contra o fake — os cassettes publicados vem do prod (API
# real, PROFILE=prod), pra o replay ser fiel. Replay ignora isto (applyVCR forca
# 10ms/5min).
MGC_POLLING_INTERVAL=200ms
MGC_POLLING_TIMEOUT=5m

# Bucket de cassettes (object storage) — usado por `make download-cassetes` e
# `make pre-commit`. Sao chaves de acesso do Object Storage (key pair S3), NAO
# a MGC_API_KEY acima. Bucket e endpoint tem defaults (comentados abaixo).
MGC_CASSETTE_KEY_ID=<object-storage access key id>
MGC_CASSETTE_KEY_SECRET=<object-storage secret>
# MGC_CASSETTE_BUCKET=tf-acctest-bucket
# MGC_CASSETTE_ENDPOINT=https://br-ne1.magaluobjects.com
