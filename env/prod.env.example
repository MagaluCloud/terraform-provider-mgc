# Perfil prod: API real. MGC_ENDPOINT e OBRIGATORIO — aponte para a raiz da API
# alvo (a regiao e anexada automaticamente). Sem ele, record/live abortam: os
# testes nao caem mais na URL default do provider. Polling omitido = default de
# cada resource (ritmo real, cassettes fieis).
# Copie para env/prod.env (gitignorado) e preencha a chave e o endpoint.
MGC_ENDPOINT=https://api.magalu.cloud
MGC_API_KEY=coloque-sua-api-key-aqui
MGC_REGION=br-me1

# Bucket de cassettes (object storage) — usado por `make download-cassetes` e
# `make pre-commit`. Sao chaves de acesso do Object Storage (key pair S3), NAO
# a MGC_API_KEY acima. Bucket e endpoint tem defaults (comentados abaixo).
MGC_CASSETTE_KEY_ID=<object-storage access key id>
MGC_CASSETTE_KEY_SECRET=<object-storage secret>
# MGC_CASSETTE_BUCKET=tf-acctest-bucket
# MGC_CASSETTE_ENDPOINT=https://br-ne1.magaluobjects.com
